{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rewind Lite keyframe annotation array",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["query", "video_id"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "query": {"type": "string", "minLength": 1},
      "query_vi": {"type": "string"},
      "video_id": {"type": "string", "minLength": 1},
      "time_window": {"$ref": "#/$defs/window"},
      "time_windows": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/window"}
      }
    },
    "oneOf": [
      {"required": ["time_window"], "not": {"required": ["time_windows"]}},
      {"required": ["time_windows"], "not": {"required": ["time_window"]}}
    ],
    "additionalProperties": false
  },
  "$defs": {
    "window": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
